{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "omnicol",
  "author": "Ben",
  "themes": [
    {
      "name": "omnicol",
      "appearance": "dark",
      "style": {
        "background": "#1c1b22",
        "surface.background": "#26252e",
        "elevated_surface.background": "#26252e",
        "panel.background": "#1c1b22",
        "tab_bar.background": "#1c1b22",
        "tab.active_background": "#26252e",
        "tab.inactive_background": "#1c1b22",
        "title_bar.background": "#1c1b22",
        "status_bar.background": "#1c1b22",
        "toolbar.background": "#1c1b22",
        "border": "#34323f",
        "border.variant": "#26252e",
        "border.focused": "#425fed",
        "text": "#e6e1d6",
        "text.muted": "#8584be",
        "text.accent": "#69b09c",
        "icon": "#e6e1d6",
        "icon.muted": "#8584be",
        "element.hover": "#34323f",
        "element.selected": "#34323f",
        "ghost_element.hover": "#26252e",
        "ghost_element.selected": "#34323f",
        "editor.background": "#1c1b22",
        "editor.gutter.background": "#1c1b22",
        "editor.foreground": "#e6e1d6",
        "editor.active_line.background": "#26252e",
        "editor.line_number": "#4f4c5e",
        "editor.active_line_number": "#dec03c",
        "editor.document_highlight.read_background": "#34323f",
        "search.match_background": "#dec03c55",
        "error": "#b82033",
        "warning": "#fa8e1b",
        "info": "#69b09c",
        "hint": "#8584be",
        "created": "#69b09c",
        "deleted": "#b82033",
        "modified": "#fa8e1b",
        "players": [
          { "cursor": "#fa8e1b", "background": "#fa8e1b", "selection": "#81207e99" },
          { "cursor": "#69b09c", "background": "#69b09c", "selection": "#69b09c44" },
          { "cursor": "#cf84b2", "background": "#cf84b2", "selection": "#cf84b244" },
          { "cursor": "#425fed", "background": "#425fed", "selection": "#425fed44" }
        ],
        "syntax": {
          "comment": { "color": "#8584be", "font_style": "italic" },
          "comment.doc": { "color": "#8584be", "font_style": "italic" },
          "constant": { "color": "#fa8e1b" },
          "number": { "color": "#fa8e1b" },
          "boolean": { "color": "#fa8e1b" },
          "string": { "color": "#738c18" },
          "string.escape": { "color": "#69b09c" },
          "function": { "color": "#69b09c" },
          "keyword": { "color": "#cf84b2" },
          "type": { "color": "#dec03c" },
          "constructor": { "color": "#dec03c" },
          "attribute": { "color": "#69b09c" },
          "tag": { "color": "#cf84b2" },
          "property": { "color": "#e6e1d6" },
          "variable": { "color": "#e6e1d6" },
          "variable.special": { "color": "#fa8e1b" },
          "operator": { "color": "#e6e1d6" },
          "punctuation": { "color": "#e6e1d6" },
          "title": { "color": "#dec03c", "font_weight": 700 },
          "link_uri": { "color": "#69b09c" },
          "link_text": { "color": "#cf84b2" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 }
        }
      }
    }
  ]
}
